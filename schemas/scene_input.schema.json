{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene_input.schema.json",
  "title": "Scene Input",
  "description": "Human-authored input to the Scene Producer: structure (elements) + synopsis. The user owns structure; the LLM owns content (DESIGN.md §16.11).",
  "type": "object",
  "required": ["scene_id", "title", "synopsis", "elements"],
  "additionalProperties": false,
  "properties": {
    "scene_id": {
      "type": "string",
      "pattern": "^s\\d+$"
    },
    "chapter_tag": {
      "type": "string",
      "pattern": "^c\\d{2}$",
      "description": "Optional display-only tag; names the scene file (e.g. c01_s702.yaml)."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "synopsis": {
      "type": "string",
      "minLength": 1,
      "description": "Free-text narrative synopsis for the whole scene."
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["layout"],
            "additionalProperties": false,
            "properties": { "layout": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
          },
          {
            "type": "object",
            "required": ["strip"],
            "additionalProperties": false,
            "properties": { "strip": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
          },
          {
            "type": "object",
            "required": ["panel"],
            "additionalProperties": false,
            "properties": { "panel": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
          }
        ]
      }
    }
  }
}
