# =============================================================================
# .gitignore — Graphic Novel Pipeline
# =============================================================================
# Reference images (PNGs) are synced from external storage, NOT tracked in git.
# The assets_manifest.yaml file IS tracked and serves as the source of truth
# for which images should exist. See scripts/sync_assets.py.
# =============================================================================

# -- Reference images (gitignored, synced from external storage) --
characters/**/*.png
environments/**/*.png

# -- Generated output (panel images, PanelSpecs, provenance) --
output/

# -- Environment variables --
.env

# -- Python --
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# -- OS --
.DS_Store
Thumbs.db

# -- Editor --
.vscode/
.idea/
*.swp
*.swo
